TZ=America/Sao_Paulo
PORT=3000

# ===== Provedor de IA (principal) =====
# xkiro | apinex | openai-compatible
AI_PROVIDER=xkiro
# xKiro: https://api.xkiro.com/v1 (pode deixar em branco, é o padrão). APInex/outros: obrigatório
AI_BASE_URL=https://api.xkiro.com/v1
AI_API_KEY=
AI_MODEL=mistralai/mistral-large-2512
# Lista de modelos que o dono pode alternar pelo WhatsApp (/modelos, /modelo N), separados por vírgula
AI_MODELS=mistralai/mistral-large-2512,mistralai/mistral-medium-3.5,mistralai/mistral-small-2603,qwen/qwen3.7-plus:free,qwen/qwen3.7-flash:free,qwen/qwen3.6-27b:free,qwen/qwen3.5-flash:free,cohere/command-a,cohere/command-a-reasoning
AI_TIMEOUT_MS=30000

# ===== Provedor alternativo (fallback automático se o principal falhar) =====
# APInex: copie a URL-base da documentação do painel (não presumida pelo código)
ALT_AI_PROVIDER=apinex
ALT_AI_BASE_URL=
ALT_AI_API_KEY=
ALT_AI_MODEL=

# ===== Evolution API =====
EVOLUTION_URL=http://localhost:8080
EVOLUTION_KEY=
INSTANCE=meubot
# Seu número pessoal com DDI (recebe avisos e comandos). Ex: 5521999999999
DONO_NUMERO=

# ===== Áudio (opcional) =====
# none | groq
AUDIO_PROVIDER=none
GROQ_KEY=

# ===== Modos =====
ATENDIMENTO=1
PROSPECCAO=0
# direto | curioso | consultivo | amigavel
ESTILO=amigavel
HORA_INICIO=9
HORA_FIM=18
LIMITE_DIA=30
