{
  "name": "bot-dpt",
  "productName": "BOT DPT",
  "version": "1.0.0",
  "description": "Bot de atendimento no WhatsApp com IA, painel próprio e busca de clientes no Google Maps",
  "author": "BOT DPT",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "app": "electron .",
    "painel": "node servidor-painel.js",
    "test": "node --test test/providers.test.js",
    "icone": "node gerar-ico.mjs",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.botdpt.app",
    "productName": "BOT DPT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "public/**",
      "src/**",
      "node_modules/**/*",
      "servidor-painel.js",
      "package.json",
      "build/**"
    ],
    "extraResources": [
      { "from": "recursos/node/node.exe", "to": "node/node.exe" },
      { "from": "servidor-painel.js", "to": "app/servidor-painel.js" },
      { "from": "public", "to": "app/public" },
      { "from": "src", "to": "app/src" },
      { "from": "node_modules/accepts", "to": "app/node_modules/accepts" },
      { "from": "node_modules/array-flatten", "to": "app/node_modules/array-flatten" },
      { "from": "node_modules/body-parser", "to": "app/node_modules/body-parser" },
      { "from": "node_modules/bytes", "to": "app/node_modules/bytes" },
      { "from": "node_modules/call-bind-apply-helpers", "to": "app/node_modules/call-bind-apply-helpers" },
      { "from": "node_modules/call-bound", "to": "app/node_modules/call-bound" },
      { "from": "node_modules/content-disposition", "to": "app/node_modules/content-disposition" },
      { "from": "node_modules/content-type", "to": "app/node_modules/content-type" },
      { "from": "node_modules/cookie", "to": "app/node_modules/cookie" },
      { "from": "node_modules/cookie-signature", "to": "app/node_modules/cookie-signature" },
      { "from": "node_modules/debug", "to": "app/node_modules/debug" },
      { "from": "node_modules/depd", "to": "app/node_modules/depd" },
      { "from": "node_modules/destroy", "to": "app/node_modules/destroy" },
      { "from": "node_modules/dunder-proto", "to": "app/node_modules/dunder-proto" },
      { "from": "node_modules/ee-first", "to": "app/node_modules/ee-first" },
      { "from": "node_modules/encodeurl", "to": "app/node_modules/encodeurl" },
      { "from": "node_modules/es-define-property", "to": "app/node_modules/es-define-property" },
      { "from": "node_modules/es-errors", "to": "app/node_modules/es-errors" },
      { "from": "node_modules/es-object-atoms", "to": "app/node_modules/es-object-atoms" },
      { "from": "node_modules/escape-html", "to": "app/node_modules/escape-html" },
      { "from": "node_modules/etag", "to": "app/node_modules/etag" },
      { "from": "node_modules/express", "to": "app/node_modules/express" },
      { "from": "node_modules/finalhandler", "to": "app/node_modules/finalhandler" },
      { "from": "node_modules/forwarded", "to": "app/node_modules/forwarded" },
      { "from": "node_modules/fresh", "to": "app/node_modules/fresh" },
      { "from": "node_modules/function-bind", "to": "app/node_modules/function-bind" },
      { "from": "node_modules/get-intrinsic", "to": "app/node_modules/get-intrinsic" },
      { "from": "node_modules/get-proto", "to": "app/node_modules/get-proto" },
      { "from": "node_modules/gopd", "to": "app/node_modules/gopd" },
      { "from": "node_modules/has-symbols", "to": "app/node_modules/has-symbols" },
      { "from": "node_modules/hasown", "to": "app/node_modules/hasown" },
      { "from": "node_modules/http-errors", "to": "app/node_modules/http-errors" },
      { "from": "node_modules/iconv-lite", "to": "app/node_modules/iconv-lite" },
      { "from": "node_modules/inherits", "to": "app/node_modules/inherits" },
      { "from": "node_modules/ipaddr.js", "to": "app/node_modules/ipaddr.js" },
      { "from": "node_modules/math-intrinsics", "to": "app/node_modules/math-intrinsics" },
      { "from": "node_modules/media-typer", "to": "app/node_modules/media-typer" },
      { "from": "node_modules/merge-descriptors", "to": "app/node_modules/merge-descriptors" },
      { "from": "node_modules/methods", "to": "app/node_modules/methods" },
      { "from": "node_modules/mime", "to": "app/node_modules/mime" },
      { "from": "node_modules/mime-db", "to": "app/node_modules/mime-db" },
      { "from": "node_modules/mime-types", "to": "app/node_modules/mime-types" },
      { "from": "node_modules/ms", "to": "app/node_modules/ms" },
      { "from": "node_modules/negotiator", "to": "app/node_modules/negotiator" },
      { "from": "node_modules/object-inspect", "to": "app/node_modules/object-inspect" },
      { "from": "node_modules/on-finished", "to": "app/node_modules/on-finished" },
      { "from": "node_modules/parseurl", "to": "app/node_modules/parseurl" },
      { "from": "node_modules/path-to-regexp", "to": "app/node_modules/path-to-regexp" },
      { "from": "node_modules/proxy-addr", "to": "app/node_modules/proxy-addr" },
      { "from": "node_modules/qs", "to": "app/node_modules/qs" },
      { "from": "node_modules/range-parser", "to": "app/node_modules/range-parser" },
      { "from": "node_modules/raw-body", "to": "app/node_modules/raw-body" },
      { "from": "node_modules/safe-buffer", "to": "app/node_modules/safe-buffer" },
      { "from": "node_modules/safer-buffer", "to": "app/node_modules/safer-buffer" },
      { "from": "node_modules/send", "to": "app/node_modules/send" },
      { "from": "node_modules/serve-static", "to": "app/node_modules/serve-static" },
      { "from": "node_modules/setprototypeof", "to": "app/node_modules/setprototypeof" },
      { "from": "node_modules/side-channel", "to": "app/node_modules/side-channel" },
      { "from": "node_modules/side-channel-list", "to": "app/node_modules/side-channel-list" },
      { "from": "node_modules/side-channel-map", "to": "app/node_modules/side-channel-map" },
      { "from": "node_modules/side-channel-weakmap", "to": "app/node_modules/side-channel-weakmap" },
      { "from": "node_modules/statuses", "to": "app/node_modules/statuses" },
      { "from": "node_modules/toidentifier", "to": "app/node_modules/toidentifier" },
      { "from": "node_modules/type-is", "to": "app/node_modules/type-is" },
      { "from": "node_modules/unpipe", "to": "app/node_modules/unpipe" },
      { "from": "node_modules/utils-merge", "to": "app/node_modules/utils-merge" },
      { "from": "node_modules/vary", "to": "app/node_modules/vary" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icone.ico",
      "artifactName": "BOT-DPT-Instalador-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BOT DPT",
      "installerIcon": "build/icone.ico",
      "uninstallDisplayName": "BOT DPT"
    }
  }
}
